@@ -0,0 +1,91 @@
+// SPDX-FileCopyrightText: 2026 Sepehr contributors
+// SPDX-License-Identifier: LGPL-3.0-only
+
+extern alias BouncyCastle;
+
+using System;
+using System.Diagnostics;
+using Nethermind.Core;
+using Nethermind.Evm.Precompiles;
+using Nethermind.Specs.Forks;
+using NUnit.Framework;
+using BouncyCastle::Org.BouncyCastle.Crypto;
+using BouncyCastle::Org.BouncyCastle.Crypto.Generators;
+using BouncyCastle::Org.BouncyCastle.Crypto.Parameters;
+using BouncyCastle::Org.BouncyCastle.Security;
+
+namespace Nethermind.Evm.Test;
+
+public class Mldsa65PrecompileTests
+{
+    [Test]
+    public void VerifiesMldsa65AndRejectsTampering()
+    {
+        MLDsaKeyPairGenerator generator = new();
+        generator.Init(new MLDsaKeyGenerationParameters(new SecureRandom(), MLDsaParameters.ml_dsa_65));
+        AsymmetricCipherKeyPair keyPair = generator.GenerateKeyPair();
+        byte[] message = new byte[Mldsa65Precompile.MessageLength];
+        Random.Shared.NextBytes(message);
+
+        ISigner signer = SignerUtilities.GetSigner("ML-DSA-65");
+        signer.Init(true, keyPair.Private);
+        signer.BlockUpdate(message);
+        byte[] signature = signer.GenerateSignature();
+        byte[] publicKey = ((MLDsaPublicKeyParameters)keyPair.Public).GetEncoded();
+
+        Assert.That(publicKey, Has.Length.EqualTo(Mldsa65Precompile.PublicKeyLength));
+        Assert.That(signature, Has.Length.EqualTo(Mldsa65Precompile.SignatureLength));
+
+        byte[] input = new byte[Mldsa65Precompile.InputLength];
+        message.CopyTo(input, 0);
+        publicKey.CopyTo(input, message.Length);
+        signature.CopyTo(input, message.Length + publicKey.Length);
+
+        Result<byte[]> valid = Mldsa65Precompile.Instance.Run(input, Prague.Instance);
+        Assert.That(valid.Data, Has.Length.EqualTo(32));
+        Assert.That(valid.Data[^1], Is.EqualTo(1));
+
+        input[^1] ^= 1;
+        Result<byte[]> tampered = Mldsa65Precompile.Instance.Run(input, Prague.Instance);
+        Assert.That(tampered.Data, Is.Empty);
+    }
+
+    [Test]
+    public void ChargesFixedConservativeGasAndRejectsMalformedLengths()
+    {
+        Assert.That(Mldsa65Precompile.Instance.BaseGasCost(Prague.Instance), Is.EqualTo(250_000L));
+        Assert.That(Mldsa65Precompile.Instance.DataGasCost(ReadOnlyMemory<byte>.Empty, Prague.Instance), Is.Zero);
+        Assert.That(Mldsa65Precompile.Instance.Run(new byte[Mldsa65Precompile.InputLength - 1], Prague.Instance).Data, Is.Empty);
+        Assert.That(Mldsa65Precompile.Instance.Run(new byte[Mldsa65Precompile.InputLength + 1], Prague.Instance).Data, Is.Empty);
+    }
+
+    [Test]
+    public void ReportsVerificationTimingForGasCalibration()
+    {
+        MLDsaKeyPairGenerator generator = new();
+        generator.Init(new MLDsaKeyGenerationParameters(new SecureRandom(), MLDsaParameters.ml_dsa_65));
+        AsymmetricCipherKeyPair keyPair = generator.GenerateKeyPair();
+        byte[] message = new byte[Mldsa65Precompile.MessageLength];
+        Random.Shared.NextBytes(message);
+        ISigner signer = SignerUtilities.GetSigner("ML-DSA-65");
+        signer.Init(true, keyPair.Private);
+        signer.BlockUpdate(message);
+        byte[] signature = signer.GenerateSignature();
+        byte[] publicKey = ((MLDsaPublicKeyParameters)keyPair.Public).GetEncoded();
+        byte[] input = new byte[Mldsa65Precompile.InputLength];
+        message.CopyTo(input, 0);
+        publicKey.CopyTo(input, message.Length);
+        signature.CopyTo(input, message.Length + publicKey.Length);
+
+        const int iterations = 25;
+        Stopwatch stopwatch = Stopwatch.StartNew();
+        for (int i = 0; i < iterations; i++)
+        {
+            Assert.That(Mldsa65Precompile.Instance.Run(input, Prague.Instance).Data, Has.Length.EqualTo(32));
+        }
+        stopwatch.Stop();
+
+        TestContext.Out.WriteLine(
+            $"ML-DSA-65 verify: {stopwatch.Elapsed.TotalMilliseconds / iterations:F3} ms average; fixed gas: 250000; input: {Mldsa65Precompile.InputLength} bytes");
+    }
+}
