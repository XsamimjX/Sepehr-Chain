+func TestStatus_BestNonFinalized_IncludesEqualHeadPeers(t *testing.T) {
+	p := peers.NewStatus(t.Context(), &peers.StatusConfig{
+		PeerLimit: 30,
+		ScorerParams: &scorers.Config{
+			BadResponsesScorerConfig: &scorers.BadResponsesScorerConfig{Threshold: 2},
+		},
+	})
+
+	headEpoch := primitives.Epoch(5)
+	headSlot := params.BeaconConfig().SlotsPerEpoch.Mul(uint64(headEpoch))
+	for i := 0; i < 3; i++ {
+		pid := peer.ID(rune(i))
+		p.Add(new(enr.Record), pid, nil, network.DirOutbound)
+		p.SetConnectionState(pid, peers.Connected)
+		p.SetChainState(pid, &pb.StatusV2{HeadSlot: headSlot})
+	}
+
+	retEpoch, pids := p.BestNonFinalized(3, headEpoch)
+	assert.Equal(t, headEpoch, retEpoch)
+	assert.Equal(t, 3, len(pids))
+}
